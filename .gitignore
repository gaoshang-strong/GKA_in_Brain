# ---- 大体积原始数据：不入库，按 ChEMBL/ChEMBL_37/README_ChEMBL_37.md 重新下载 ----
*.tar.gz
*.db
*.db-journal
*.db-wal
*.h5
*.sdf
*.fps
*.fa
# 解压出来的 ChEMBL 数据库目录（内含 ~30 GB 的 .db）
ChEMBL/*/chembl_*/

# EBI 随数据库一同下载的官方文件：只保留目录结构，不入库
# （重新下载方式见 ChEMBL/ChEMBL_37/README_ChEMBL_37.md）
ChEMBL/*/LICENSE
ChEMBL/*/README
ChEMBL/*/REQUIRED.ATTRIBUTION
ChEMBL/*/checksums.txt
ChEMBL/*/chembl_*_release_notes.txt
ChEMBL/*/chembl_*_schema.pdf
ChEMBL/*/schema_documentation.txt

# ---- SureChEMBL 2.0 全量 parquet：~17 GB，不入库 ----
# （重新下载见 SureChEMBL/SureChEMBL_2026-07-17/README_SureChEMBL_2026-07-17.md，
#   下载脚本 .download.sh 与服务端清单 .server_manifest.tsv 一并保留在库里）
*.parquet
SureChEMBL/*/LICENCE

# ---- Python ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# ---- 编辑器 / 系统 ----
.DS_Store
.vscode/
.idea/
*.swp

# LLM 响应缓存（可由脚本重建）
.llm_cache.json
